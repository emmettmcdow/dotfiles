#!/usr/bin/env bash
# Report which of the tools this setup expects are actually on PATH. Exits
# nonzero if anything is missing.
set -uo pipefail

packages=(
    "go"
    "gopls"
    "dlv"
    "hx"
    "python3"
    "git"
    "make"
    "tar"
    "zsh"
    "bash-language-server"
    "typescript-language-server"
    "typescript"
    "npx"
    "vscode-eslint-language-server"
)

status=0

# Make sure to update the width if a program name gets too long
for p in "${packages[@]}"; do
    if command -v "$p" &>/dev/null; then
        printf "%-30s   \033[32m%s\033[39m\n" "$p" "✓"
    else
        printf "%-30s   \033[31m%s\033[39m\n" "$p" "✗"
        status=1
    fi
done

exit "$status"
